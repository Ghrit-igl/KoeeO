# ==============================================================================
# KOEEO DYNAMIC CAD & STRESS ENGINE — PURE AAYU SILICON VM
# Computes multi-part mechanical stresses, thermal thresholds, horsepower,
# and 3D exploded assembly vectors for user-requested machinery & science models.
# ==============================================================================

import "../../../INTENT-TO-SILICON/std/math.aayu"

# Material yield strength (MPa), thermal expansion coefficient (1e-6/K), density (g/cm3)
action get_material_properties(mat_name)
    if mat_name == "titanium_ti6al4v"
        return { "yield_mpa": 950.0, "thermal_k": 8.6, "density": 4.43, "cost_idx": 4.5 }
    elif mat_name == "forged_carbon"
        return { "yield_mpa": 1200.0, "thermal_k": 1.2, "density": 1.55, "cost_idx": 6.0 }
    elif mat_name == "inconel_718"
        return { "yield_mpa": 1100.0, "thermal_k": 13.0, "density": 8.19, "cost_idx": 5.0 }
    elif mat_name == "silicon_nitride_ceramic"
        return { "yield_mpa": 850.0, "thermal_k": 3.0, "density": 3.20, "cost_idx": 7.0 }
    else
        # Standard Forged Aluminum 7075-T6
        return { "yield_mpa": 505.0, "thermal_k": 23.4, "density": 2.81, "cost_idx": 1.0 }
    end
end

action compute_engine_physics(rpm, boost_bar, displacement_cc, piston_mat, supercharger_mat)
    let p_mat = get_material_properties(piston_mat)
    let s_mat = get_material_properties(supercharger_mat)

    # 1. Volumetric Airflow & Boost Multiplier
    # Naturally aspirated baseline + boost pressure (bar)
    let pressure_ratio = 1.0 + boost_bar
    let airflow_cfm = (displacement_cc * 0.0610237 * rpm * 0.88 * pressure_ratio) / 3456.0

    # 2. Horsepower & Torque derivation
    # HP approx: displacement_l * 105 * pressure_ratio * (rpm / 8000)
    let disp_l = displacement_cc / 1000.0
    let base_hp = disp_l * 115.0 * pressure_ratio * (rpm / 9000.0)
    let torque_nm = (base_hp * 7127.0) / rpm

    # 3. Peak Cylinder Pressure (bar) & Piston Mechanical Stress (MPa)
    let peak_cyl_pressure_bar = 85.0 * pressure_ratio
    let applied_piston_stress = peak_cyl_pressure_bar * 4.2

    # Thermal expansion stress based on material thermal coefficient
    let temp_delta = 450.0 + (boost_bar * 120.0)
    let thermal_stress = p_mat["thermal_k"] * temp_delta * 0.08
    let total_stress = applied_piston_stress + thermal_stress

    # 4. Safety Factor & Structural Integrity
    let safety_factor = p_mat["yield_mpa"] / total_stress
    let failure_risk_pct = 0.0
    if safety_factor < 1.0
        failure_risk_pct = (1.0 - safety_factor) * 150.0
        if failure_risk_pct > 100.0
            failure_risk_pct = 100.0
        end
    elif safety_factor < 1.25
        failure_risk_pct = (1.25 - safety_factor) * 40.0
    end

    # 5. Supercharger Impeller Tip Speed (Mach number)
    # Impeller spins at ~9.2x engine RPM (Planetary gear drive)
    let impeller_rpm = rpm * 9.2
    let impeller_dia_m = 0.069 # 69mm billet 5-axis impeller
    let tip_speed_ms = (impeller_rpm * 3.14159 * impeller_dia_m) / 60.0
    let mach_number = tip_speed_ms / 343.0

    # Output Structured Silicon Telemetry
    print("---AAYU_CAD_START---")
    print("RPM=" + rpm)
    print("BOOST_BAR=" + boost_bar)
    print("DISPLACEMENT_CC=" + displacement_cc)
    print("AIRFLOW_CFM=" + airflow_cfm)
    print("HORSEPOWER=" + base_hp)
    print("TORQUE_NM=" + torque_nm)
    print("TOTAL_STRESS_MPA=" + total_stress)
    print("YIELD_MPA=" + p_mat["yield_mpa"])
    print("SAFETY_FACTOR=" + safety_factor)
    print("FAILURE_RISK_PCT=" + failure_risk_pct)
    print("TEMP_DELTA_C=" + temp_delta)
    print("IMPELLER_RPM=" + impeller_rpm)
    print("TIP_SPEED_MS=" + tip_speed_ms)
    print("MACH_NUMBER=" + mach_number)
    print("---AAYU_CAD_END---")
end

action main()
    # Test simulation for Kawasaki Ninja H2R: 998cc, 14000 RPM, 2.4 bar boost
    compute_engine_physics(14000.0, 2.4, 998.0, "titanium_ti6al4v", "forged_carbon")
end

main()
